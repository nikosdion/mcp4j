<config>
    <fieldset
            name="general"
            label="COM_MCP4J_CONFIG_OPTIONS_GENERAL_LABEL"
    >
        <field
                name="session_ttl"
                type="number"
                label="COM_MCP4J_CONFIG_SESSION_TTL_LABEL"
                description="COM_MCP4J_CONFIG_SESSION_TTL_DESC"
                default="3600"
                filter="integer"
        />

        <field
                name="prune_on_request"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                label="COM_MCP4J_CONFIG_PRUNE_ON_REQUEST_LABEL"
                description="COM_MCP4J_CONFIG_PRUNE_ON_REQUEST_DESC"
                default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset
            name="tools"
            label="COM_MCP4J_CONFIG_OPTIONS_TOOLS_LABEL"
            addfieldprefix="Akeeba\Component\Mcp4j\Administrator\Field"
    >
        <field
                name="category_mode"
                type="radio"
                label="COM_MCP4J_CONFIG_CATEGORY_MODE_LABEL"
                description="COM_MCP4J_CONFIG_CATEGORY_MODE_DESC"
                default="exclude"
        >
            <option value="include">COM_MCP4J_CONFIG_MODE_INCLUDE</option>
            <option value="exclude">COM_MCP4J_CONFIG_MODE_EXCLUDE</option>
        </field>

        <field
                name="categories"
                type="ToolCategories"
                multiple="true"
                layout="joomla.form.field.list-fancy-select"
                label="COM_MCP4J_CONFIG_CATEGORIES_LABEL"
                description="COM_MCP4J_CONFIG_CATEGORIES_DESC"
        />

        <field
                name="tool_mode"
                type="radio"
                label="COM_MCP4J_CONFIG_TOOL_MODE_LABEL"
                description="COM_MCP4J_CONFIG_TOOL_MODE_DESC"
                default="exclude"
        >
            <option value="include">COM_MCP4J_CONFIG_MODE_INCLUDE</option>
            <option value="exclude">COM_MCP4J_CONFIG_MODE_EXCLUDE</option>
        </field>

        <field
                name="tools"
                type="ToolNames"
                multiple="true"
                layout="joomla.form.field.groupedlist-fancy-select"
                label="COM_MCP4J_CONFIG_TOOLS_LABEL"
                description="COM_MCP4J_CONFIG_TOOLS_DESC"
        />

        <field
                name="read_only"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                label="COM_MCP4J_CONFIG_READ_ONLY_LABEL"
                description="COM_MCP4J_CONFIG_READ_ONLY_DESC"
                default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
                name="minimal_schema"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                label="COM_MCP4J_CONFIG_MINIMAL_SCHEMA_LABEL"
                description="COM_MCP4J_CONFIG_MINIMAL_SCHEMA_DESC"
                default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
                name="forbidden_secrets"
                type="textarea"
                filter="raw"
                rows="5"
                label="COM_MCP4J_CONFIG_FORBIDDEN_SECRETS_LABEL"
                description="COM_MCP4J_CONFIG_FORBIDDEN_SECRETS_DESC"
        />

        <field
                name="debug_log"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                label="COM_MCP4J_CONFIG_DEBUG_LOG_LABEL"
                description="COM_MCP4J_CONFIG_DEBUG_LOG_DESC"
                default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset
            name="permissions"
            label="JCONFIG_PERMISSIONS_LABEL"
            description="JCONFIG_PERMISSIONS_DESC"
    >
        <field
                name="rules"
                type="rules"
                label="JCONFIG_PERMISSIONS_LABEL"
                class="inputbox"
                filter="rules"
                component="com_mcp4j"
                section="component"
        />
    </fieldset>
</config>

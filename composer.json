{
  "name": "akeeba/pkg_mcp4j",
  "description": "MCP4j – Remote, HTTP-based Model Context Protocol server for Joomla",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Nicholas K. Dionysopoulos",
      "email": "nicholas@akeeba.com",
      "homepage": "https://www.akeeba.com",
      "role": "Lead Developer"
    }
  ],
  "require": {
    "php": ">=8.1.0 <8.7",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "league/commonmark": "^2.7"
  },
  "config": {
    "vendor-dir": "component/backend/vendor",
    "platform": {
      "php": "8.1.999"
    },
    "optimize-autoloader": false
  },
  "extra": {
    "akcompat": {
      "limit_type": "joomla",
      "limit": ">=4.0.0 <6.3",
      "locations": [
        {
          "file": "component/script.mcp4j.php",
          "type": "variable",
          "marker": "$minimumPhp",
          "value": "PHP_MIN"
        },
        {
          "file": "component/script.mcp4j.php",
          "type": "variable",
          "marker": "$maximumPhp",
          "value": "PHP_MAX"
        },
        {
          "file": "component/script.mcp4j.php",
          "type": "variable",
          "marker": "$minimumJoomla",
          "value": "LIMIT_MIN"
        },
        {
          "file": "component/script.mcp4j.php",
          "type": "variable",
          "marker": "$maximumJoomla",
          "value": "LIMIT_MAX"
        }
      ]
    }
  }
}

# Extra Joomla/PHP environments for MCP4j, on top of buildfiles/docker/e2e/matrix. Committed on
# purpose: sourced by run-tests.sh after .env, so every checkout tests the same thing.
#
# MCP4j still supports Joomla 4.4 (script.pkg_mcp4j.php). Its composer.json requires PHP 8.1 or later,
# so 4.4 runs on PHP 8.1, not on Joomla 4.4's own PHP 7.4 floor. Drop the first entry, and this file,
# when Joomla 4 support goes.
JOOMLA_MATRIX="4.4:8.1 5.4:8.1 6:8.5"

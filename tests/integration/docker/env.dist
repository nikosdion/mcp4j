# Configuration for the Dockerized integration test stack.
#
# Copy this file to .env and edit as needed, or just run run-tests.sh which
# creates .env from this template automatically on first run.

# ----------------------------------------------------------------------------
# Version matrix. Space-separated `joomla:php` pairs, oldest first. A plain
# run-tests.sh (no version arguments) runs every entry — see
# ../README.md, "Why these versions" for why exactly these three and this
# PHP pairing. Each entry's Joomla side may be a full version (6.1.1), a
# branch (6.1) or a bare major (6); for a partial version the latest matching
# STABLE release is resolved/downloaded.
# ----------------------------------------------------------------------------
JOOMLA_MATRIX="4.4:8.1 5.4:8.1 6:8.5"

# Fallback PHP version for a Joomla version passed on the run-tests.sh command
# line that isn't one of the JOOMLA_MATRIX entries above.
PHP_VERSION=8.3

DB_IMAGE=mariadb:11.4

# ----------------------------------------------------------------------------
# Database.
# ----------------------------------------------------------------------------
DB_ROOT_PASSWORD=rootpw
DB_NAME=joomla_test
DB_USER=root
DB_PASSWORD=rootpw
DB_PREFIX=jtest_

# ----------------------------------------------------------------------------
# Host ports.
# ----------------------------------------------------------------------------
# The site is reachable at http://localhost:${WEB_PORT} from the host.
WEB_PORT=8180

# ----------------------------------------------------------------------------
# Parallel runs (e.g. several git worktrees testing different plan branches at
# once). WEB_PORT and COMPOSE_PROJECT_NAME can both be overridden from the
# *process* environment without editing this file — run-tests.sh and quick.sh
# always let an already-set environment variable win over the value below
# (see ../README.md, "Parallel runs from git worktrees"):
#
#   COMPOSE_PROJECT_NAME=mcp4j-itest-p04 WEB_PORT=8184 tests/integration/run-tests.sh 6 --keep
#
# COMPOSE_PROJECT_NAME defaults to mcp4j-itest (docker-compose.yml's own `name:`) when unset here and
# not present in the environment either.
# COMPOSE_PROJECT_NAME=mcp4j-itest
